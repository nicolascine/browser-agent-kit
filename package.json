{
  "name": "browser-agent-kit",
  "version": "0.3.1",
  "description": "Toolkit for building AI agents that operate in the browser",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=neutral --outfile=dist/index.js && tsc --emitDeclarationOnly --declaration --outDir dist",
    "prepare": "npm run build",
    "test": "vitest run",
    "dev": "esbuild src/index.ts --bundle --format=esm --platform=neutral --outfile=dist/index.js --watch",
    "demo": "tsx examples/demo.ts",
    "demo:cl": "tsx examples/demo-cl.ts",
    "record:pro": "node examples/record-pro.mjs",
    "demo:codeact": "tsx experiments/codeact/run.ts",
    "demo:grounding": "node experiments/codeact/ground-browser.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "browser",
    "dom",
    "automation",
    "llm"
  ],
  "author": "Nicolás Silva",
  "license": "MIT",
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "esbuild": "^0.28.1",
    "jsdom": "^24.1.0",
    "playwright-core": "^1.61.1",
    "tsx": "^4.22.4",
    "typescript": "^5.6.2",
    "vitest": "^2.0.5"
  }
}
